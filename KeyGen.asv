function [seed_pk,seed_sk,P_i3_list] = KeyGen(V,M,l,q,t1,t2,lamda,g)
rb=randi([0 1], 1, lamda);
seed_pk=rb(1:lamda/2);
seed_sk=rb(lamda/2+1:lamda);
S_=Expand_sk(seed_sk,V,M,l,q,t2);
% S_=matrix_to_cell(S_);
assignin('base', 'S_', S_);
P_i3_list={};
for i=1:M*l
    [P_i1,P_i2]=Expand_pk(seed_pk,V,M,l,i,t1,t2,q);
%     P_i1=matrix_to_cell(P_i1);
%     P_i2=matrix_to_cell(P_i2);
    assignin('base', 'P_i1',  P_i1);
    assignin('base', 'P_i2', P_i2);
    tem0= poly_matrix_mult_mod(S_', P_i1, g, q);
    tem1= poly_matrix_mult_mod(tem0,S_, g, q);
    tem2=poly_matrix_mult_mod(P_i2',S_, g, q);
    tem3=poly_matrix_mult_mod(S_',P_i2, g, q);
    
    assignin('base', 'tem0',  tem0);
    assignin('base', 'tem1', tem1);
    assignin('base', 'tem2',  tem2);
    assignin('base', 'tem3', tem3);
    
    %P_i3=cell_to_matrix(tem1,l)+cell_to_matrix(tem2,l)+cell_to_matrix(tem3,l);
    P_i3=cell(M,M);
    for ii =1:M
        for jj =1:M
           P_i3{ii,jj}= tem1{ii,jj}+tem2{ii,jj}+tem3{ii,jj};
           for k=1:l
               P_i3{ii,jj}(k)=
           end
        end
    end
        
    P_i3_list{end+1}=P_i3;
end

